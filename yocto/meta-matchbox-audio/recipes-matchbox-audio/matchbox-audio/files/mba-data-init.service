[Unit]
Description=Initialize Matchbox Audio data directories
After=data.mount persistent-data-init.service
Requires=data.mount
Wants=persistent-data-init.service
Before=mba-network-mode-restore.service mba-player.service mba-device.service

[Service]
Type=oneshot
ExecStart=/usr/sbin/mba-data-init
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
